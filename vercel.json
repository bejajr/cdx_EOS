{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/app.js",
      "dest": "/public/app.js"
    },
    {
      "src": "/styles.css",
      "dest": "/public/styles.css"
    },
    {
      "src": "/api/(.*)",
      "dest": "/public/api-unavailable.json"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
