OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
# local, hybrid, or cloud
APP_MODE=local
DEFAULT_WORKSPACE_ID=local-default
DEFAULT_USER_ID=local-user
DEFAULT_GROUP_ID=group-operations

# Outlook / Microsoft 365 OAuth
# Create these in an Azure App Registration, then restart Jimmy.
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://127.0.0.1:3000/auth/outlook/callback
